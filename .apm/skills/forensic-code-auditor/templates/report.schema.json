{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "assurance": {
      "enum": [
        "VERIFIED_SCOPE",
        "PARTIAL",
        "INSUFFICIENT_EVIDENCE",
        "NOT_ASSESSED"
      ]
    },
    "conclusion": {
      "enum": [
        "FINDINGS_REPORTED",
        "NO_FINDINGS_IN_VERIFIED_SCOPE",
        "INCONCLUSIVE",
        "NOT_ASSESSED"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "enum": [
                  "ui_entry",
                  "menu_node",
                  "policy_store",
                  "stored_procedure",
                  "db_grant",
                  "api_route",
                  "gateway",
                  "queue_consumer",
                  "batch_job",
                  "scheduler",
                  "mcp_tool",
                  "db_link",
                  "direct_db_access"
                ]
              },
              "status": {
                "enum": [
                  "absent",
                  "verified",
                  "reviewed",
                  "unknown",
                  "unexamined",
                  "unsupported"
                ]
              },
              "critical": {
                "type": "boolean"
              },
              "operation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                },
                "minItems": 0
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "category",
              "status",
              "critical",
              "operation_ids",
              "evidence",
              "limitations"
            ]
          },
          "minItems": 13
        }
      },
      "required": [
        "categories"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "read",
              "value",
              "lifecycle",
              "policy"
            ]
          },
          "status": {
            "enum": [
              "complete",
              "deferred"
            ]
          },
          "reason": {
            "type": "string"
          },
          "completion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "invariant": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "unresolved"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 0
                  },
                  "needed": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence",
                  "needed"
                ]
              },
              "entry_points": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "unresolved"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 0
                  },
                  "needed": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence",
                  "needed"
                ]
              },
              "policy_provenance": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "unresolved"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 0
                  },
                  "needed": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence",
                  "needed"
                ]
              },
              "execution_trace": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "unresolved"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 0
                  },
                  "needed": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence",
                  "needed"
                ]
              },
              "competing_defenses": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "unresolved"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 0
                  },
                  "needed": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence",
                  "needed"
                ]
              },
              "failure_hypothesis": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "unresolved"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 0
                  },
                  "needed": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence",
                  "needed"
                ]
              },
              "discriminating_proof": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "unresolved"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 0
                  },
                  "needed": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence",
                  "needed"
                ]
              },
              "classification": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "unresolved"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 0
                  },
                  "needed": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence",
                  "needed"
                ]
              },
              "coverage": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "unresolved"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "minItems": 0
                  },
                  "needed": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence",
                  "needed"
                ]
              }
            },
            "required": [
              "invariant",
              "entry_points",
              "policy_provenance",
              "execution_trace",
              "competing_defenses",
              "failure_hypothesis",
              "discriminating_proof",
              "classification",
              "coverage"
            ]
          }
        },
        "required": [
          "id",
          "class",
          "status",
          "reason",
          "completion"
        ]
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "FSM-BYPASS",
              "TOCTOU-RACE",
              "LOST-UPDATE",
              "TENANT-LEAK",
              "AUTHZ-BYPASS",
              "BALANCE-VIOLATION",
              "TRANSACTION-DEMARCATION",
              "REPLAY-IDEMPOTENCY",
              "DUAL-WRITE",
              "INPUT-DOMAIN",
              "RESOURCE-LEAK",
              "ERROR-SWALLOW",
              "PERIMETER-BYPASS",
              "FAIL-OPEN-AUTH",
              "AGENTIC-TOOL-LEAK"
            ]
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "POLICY-SEMANTIC-DRIFT",
                "POLICY-EVALUATION-INCONSISTENCY",
                "POLICY-SCOPE-EXPANSION",
                "AUTHZ-DATA-INTEGRITY",
                "CROSS-ENTRYPOINT-AUTHZ-DRIFT",
                "NAVIGATION-DEPENDENT-AUTHZ",
                "TENANT-CONTEXT-INTEGRITY",
                "CONTROL-DEPENDENCY-FAILURE"
              ]
            }
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "evidence_status": {
            "enum": [
              "CONFIRMED",
              "SUSPECTED",
              "NON LIQUET",
              "REFUTED"
            ]
          },
          "verification": {
            "enum": [
              "STATIC_PROVEN",
              "DYNAMIC_REPRODUCED",
              "TEST_GENERATED",
              "NOT_VERIFIED"
            ]
          },
          "policy_basis": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "class": {
                "enum": [
                  "owner_signed",
                  "regulation",
                  "requirement_doc",
                  "contract",
                  "derived_from_code",
                  "derived_from_rows",
                  "derived_from_tests",
                  "none"
                ]
              },
              "ref": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/evidence"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "class",
              "ref"
            ]
          },
          "location": {
            "$ref": "#/$defs/evidence"
          },
          "proof": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 0
          },
          "entry_points": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "contributing_rows": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 0
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entry_point": {
                  "type": "string",
                  "minLength": 1
                },
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "type": "string",
                        "minLength": 1
                      },
                      "to": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "established",
                          "assumed",
                          "unresolved"
                        ]
                      },
                      "evidence_ref": {
                        "$ref": "#/$defs/evidence"
                      }
                    },
                    "required": [
                      "from",
                      "to",
                      "kind",
                      "status",
                      "evidence_ref"
                    ]
                  },
                  "minItems": 1
                }
              },
              "required": [
                "entry_point",
                "edges"
              ]
            },
            "minItems": 0
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "run_record": {
            "$ref": "#/$defs/evidence"
          },
          "obstruction_mechanism": {
            "enum": [
              "MISSING-POLICY",
              "MISSING-EXPORT",
              "RUNTIME-CONFIG",
              "DYNAMIC-DISPATCH",
              "EXTERNAL-RPC-OPAQUE",
              "REFLECTION",
              "UNTRACKED-TRIGGER",
              "MISSING-SCHEMA"
            ]
          },
          "telemetry_spec": {
            "type": "string"
          },
          "candidate_models": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "operation_id",
          "category",
          "tags",
          "severity",
          "evidence_status",
          "verification",
          "policy_basis",
          "location",
          "proof",
          "entry_points",
          "contributing_rows",
          "paths",
          "unresolved"
        ]
      },
      "minItems": 0
    },
    "references_loaded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "$ref": "#/$defs/evidence"
          }
        },
        "required": [
          "kind",
          "ref"
        ]
      },
      "minItems": 0
    },
    "discovery": {
      "$ref": "#/$defs/evidence"
    },
    "tools_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "outcome": {
            "enum": [
              "hits",
              "no_hits",
              "failed"
            ]
          },
          "output_ref": {
            "$ref": "#/$defs/evidence"
          }
        },
        "required": [
          "tool",
          "version",
          "command",
          "exit_code",
          "outcome",
          "output_ref"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "assurance",
    "conclusion",
    "scope",
    "operations",
    "findings",
    "references_loaded",
    "artifacts",
    "discovery",
    "tools_executed"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "row_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    }
  },
  "$id": "https://example.test/forensic-code-auditor/report-v2.schema.json"
}
